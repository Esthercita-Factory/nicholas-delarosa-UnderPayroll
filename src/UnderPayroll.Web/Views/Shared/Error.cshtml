@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="panel panel-narrow">
    <div class="panel-body">
        <span class="eyebrow">Algo salió mal</span>
        <h1 class="h3">No pudimos completar la solicitud</h1>
        <p class="text-secondary">
            Ocurrió un error inesperado. Intenta de nuevo y, si el problema continúa,
            comparte el identificador de la solicitud con el equipo de soporte.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="mb-3">
                <strong>Identificador:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
    </div>
</div>
