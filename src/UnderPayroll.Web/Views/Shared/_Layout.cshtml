@{
    // Controlador actual, usado para marcar la sección activa del menú
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - UnderPayroll</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg"/>
    <link rel="icon" href="~/favicon.ico" sizes="32x32"/>
    @* Aplica el tema guardado antes de pintar la página para evitar un destello *@
    <script>
        (function () {
            var guardado = null;
            try { guardado = localStorage.getItem("tema"); } catch (e) { }
            var tema = guardado || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            document.documentElement.setAttribute("data-bs-theme", tema);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<header>
    <nav class="navbar navbar-expand-md app-navbar">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">UP</span>
                <span class="brand-name">Under<span>Payroll</span></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Mostrar u ocultar el menú">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-md-auto gap-md-1">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Home" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Departments" ? "active" : "")"
                           asp-controller="Departments" asp-action="Index">Departamentos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Employees" ? "active" : "")"
                           asp-controller="Employees" asp-action="Index">Empleados</a>
                    </li>
                </ul>
                <button type="button" class="theme-toggle ms-md-3 mt-2 mt-md-0" id="themeToggle"
                        aria-label="Cambiar entre tema claro y oscuro">Tema oscuro</button>
            </div>
        </div>
    </nav>
</header>

<div class="container app-main py-4">
    <main role="main" id="contenido" tabindex="-1">
        @* Mensaje de resultado que dejan los controladores en TempData *@
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert flash alert-dismissible fade show" role="alert">
                @mensaje
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        @RenderBody()
    </main>
</div>

<footer class="app-footer">
    <div class="container">
        &copy; @DateTime.Now.Year UnderPayroll. Gestión de departamentos y empleados.
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
