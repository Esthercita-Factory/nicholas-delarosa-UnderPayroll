@model UnderPayroll.Web.ViewModels.Employees.EmployeeDetailsViewModel
@{
    ViewData["Title"] = "Desactivar empleado";
}

<div class="page-header">
    <div>
        <span class="eyebrow">Empleados</span>
        <h1>Desactivar empleado</h1>
    </div>
</div>

<div class="panel panel-narrow">
    <div class="panel-body">
        <div class="confirm-notice confirm-warning" role="alert">
            <div>
                <h2>¿Desactivar a este empleado?</h2>
                <p>El registro permanece en la base de datos y podrás reactivarlo más adelante.</p>
            </div>
        </div>

        <dl class="detail-list">
            <div>
                <dt>Empleado</dt>
                <dd>@Model.FullName</dd>
            </div>
            <div>
                <dt>Documento</dt>
                <dd>@Model.Document</dd>
            </div>
            <div>
                <dt>Cargo</dt>
                <dd>@Model.Position</dd>
            </div>
            <div>
                <dt>Departamento</dt>
                <dd>@Model.DepartmentName</dd>
            </div>
            <div>
                <dt>Correo electrónico</dt>
                <dd>@Model.Email</dd>
            </div>
        </dl>
    </div>

    <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" class="panel-footer">
        <button type="submit" class="btn btn-primary">Sí, desactivar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>
