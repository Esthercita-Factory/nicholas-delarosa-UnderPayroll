@model UnderPayroll.Web.ViewModels.Employees.EmployeeDetailsViewModel

<h1>Desactivar empleado</h1>

<div class="alert alert-warning">
    <h4>¿Seguro que quieres desactivar este empleado?</h4>
    <p>
        El registro permanecerá en la base de datos y podrá reactivarse después.
    </p>
</div>

<div class="card mb-3">
    <div class="card-body">

        <h2>@Model.FullName</h2>

        <p>
            <strong>Documento:</strong>
            @Model.Document
        </p>

        <p>
            <strong>Cargo:</strong>
            @Model.Position
        </p>

        <p>
            <strong>Departamento:</strong>
            @Model.DepartmentName
        </p>

        <p>
            <strong>Email:</strong>
            @Model.Email
        </p>

    </div>
</div>

<form asp-action="Deactivate"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit" class="btn btn-warning">
        Sí, desactivar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>