@model IEnumerable<UnderPayroll.Web.ViewModels.Employees.EmployeeListItemViewModel>
@{
    ViewData["Title"] = "Empleados";

    // Filtros vigentes, definidos por el controlador
    var filtros = new ListFilterViewModel(
        ViewData["Activo"] as bool?,
        ViewData["Busqueda"] as string,
        "Buscar por nombre, documento, correo, cargo o departamento");
    var hayFiltros = filtros.Activo.HasValue || !string.IsNullOrWhiteSpace(filtros.Busqueda);
    var cultura = new System.Globalization.CultureInfo("es-CO");
}

<div class="page-header">
    <div>
        <span class="eyebrow">Personal</span>
        <h1>Empleados</h1>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nuevo empleado</a>
</div>

<partial name="_ListFilters" model="filtros"/>

<div class="panel">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <h2>No hay empleados para mostrar</h2>
            <p class="mb-0">@(hayFiltros ? "Prueba con otra búsqueda o cambia el filtro." : "Registra al primer empleado para verlo en este listado.")</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table">
                <thead>
                <tr>
                    <th>Empleado</th>
                    <th>Cargo</th>
                    <th>Departamento</th>
                    <th>Contratación</th>
                    <th class="num">Salario</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var employee in Model)
                {
                    <tr>
                        <td>
                            <span class="cell-title">@employee.FirstName @employee.LastName</span>
                            <span class="cell-meta">@employee.Document</span>
                        </td>
                        <td>@employee.Position</td>
                        <td>@(employee.DepartmentName ?? "Sin departamento")</td>
                        <td>@employee.HireDate.ToString("dd/MM/yyyy")</td>
                        <td class="num">
                            @(employee.Salary.HasValue ? employee.Salary.Value.ToString("C", cultura) : "No especificado")
                        </td>
                        <td><partial name="_StatusBadge" model="employee.IsActive"/></td>
                        <td class="cell-actions">
                            <a asp-action="Details" asp-route-id="@employee.Id"
                               class="btn btn-sm btn-outline-primary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@employee.Id"
                               class="btn btn-sm btn-outline-secondary">Editar</a>

                            @* Acciones menos frecuentes agrupadas en un menú *@
                            <div class="dropdown d-inline-block">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false">Más</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (employee.IsActive)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-action="Deactivate"
                                               asp-route-id="@employee.Id">Desactivar</a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <form asp-action="Activate" asp-route-id="@employee.Id" method="post">
                                                <button type="submit" class="dropdown-item">Reactivar</button>
                                            </form>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item text-danger" asp-action="Delete"
                                           asp-route-id="@employee.Id">Eliminar</a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
