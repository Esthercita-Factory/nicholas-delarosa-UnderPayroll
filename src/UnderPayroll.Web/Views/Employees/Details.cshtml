@model UnderPayroll.Web.ViewModels.Employees.EmployeeDetailsViewModel
@{
    ViewData["Title"] = Model.FullName;
}

<div class="page-header">
    <div>
        <span class="eyebrow">Empleado</span>
        <h1>@Model.FullName</h1>
        <p class="page-subtitle">@Model.Position</p>
    </div>
</div>

<div class="panel">
    <div class="panel-heading">
        <h2>Ficha del empleado</h2>
        <partial name="_StatusBadge" model="Model.IsActive"/>
    </div>

    <div class="panel-body">
        <dl class="detail-list">
            <div>
                <dt>Documento</dt>
                <dd>@Model.Document</dd>
            </div>
            <div>
                <dt>Correo electrónico</dt>
                <dd>@Model.Email</dd>
            </div>
            <div>
                <dt>Teléfono</dt>
                <dd>@(Model.Phone ?? "No especificado")</dd>
            </div>
            <div>
                <dt>Departamento</dt>
                <dd>@Model.DepartmentName</dd>
            </div>
            <div>
                <dt>Cargo</dt>
                <dd>@Model.Position</dd>
            </div>
            <div>
                <dt>Salario</dt>
                <dd>@Model.SalaryTexto</dd>
            </div>
            <div>
                <dt>Fecha de contratación</dt>
                <dd>@Model.HireDateTexto</dd>
            </div>
            <div>
                <dt>Creado</dt>
                <dd>@Model.CreatedAtTexto</dd>
            </div>
            <div>
                <dt>Última actualización</dt>
                <dd>@Model.UpdatedAtTexto</dd>
            </div>
        </dl>
    </div>

    <div class="panel-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
    </div>
</div>
