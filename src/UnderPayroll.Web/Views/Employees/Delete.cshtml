@model UnderPayroll.Web.ViewModels.Employees.EmployeeDetailsViewModel

<h1>Eliminar empleado</h1>

<div class="alert alert-danger">
    <h4>¿Seguro que quieres eliminar este empleado?</h4>
    <p>
        Esta acción eliminará permanentemente el registro de la base de datos.
    </p>
</div>

<div class="card mb-3">
    <div class="card-body">

        <h2>@Model.FullName</h2>

        <p>
            <strong>Documento:</strong>
            @Model.Document
        </p>

        <p>
            <strong>Cargo:</strong>
            @Model.Position
        </p>

        <p>
            <strong>Departamento:</strong>
            @Model.DepartmentName
        </p>

        <p>
            <strong>Email:</strong>
            @Model.Email
        </p>

    </div>
</div>

<form asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit"
            class="btn btn-danger">
        Sí, eliminar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>