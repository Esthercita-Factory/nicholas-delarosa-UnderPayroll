@model UnderPayroll.Web.ViewModels.Departments.DepartmentDetailsViewModel

<h1>Desactivar departamento</h1>

<div class="alert alert-warning">
    <h4>¿Seguro que quieres desactivar este departamento?</h4>
    <p>
        El registro no se eliminará de la base de datos.
        Quedará inactivo y podrá reactivarse posteriormente.
    </p>
</div>

<div class="card mb-3">
    <div class="card-body">

        <h2>@Model.Name</h2>

        <p>
            <strong>Código:</strong>
            @Model.Code
        </p>

        <p>
            <strong>Descripción:</strong>
            @(Model.Description ?? "No especificada")
        </p>

        <p>
            <strong>Ubicación:</strong>
            @(Model.Location ?? "No especificada")
        </p>

    </div>
</div>

<form asp-action="Deactivate"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit" class="btn btn-warning">
        Sí, desactivar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>
</form>