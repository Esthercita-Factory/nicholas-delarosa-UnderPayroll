@model UnderPayroll.Web.ViewModels.Departments.DepartmentDetailsViewModel
@{
    ViewData["Title"] = "Desactivar departamento";
}

<div class="page-header">
    <div>
        <span class="eyebrow">Departamentos</span>
        <h1>Desactivar departamento</h1>
    </div>
</div>

<div class="panel panel-narrow">
    <div class="panel-body">
        <div class="confirm-notice confirm-warning" role="alert">
            <div>
                <h2>¿Desactivar este departamento?</h2>
                <p>
                    El registro no se elimina de la base de datos. Quedará inactivo
                    y podrás reactivarlo cuando lo necesites.
                </p>
            </div>
        </div>

        <dl class="detail-list">
            <div>
                <dt>Departamento</dt>
                <dd>@Model.Name</dd>
            </div>
            <div>
                <dt>Código</dt>
                <dd>@Model.Code</dd>
            </div>
            <div>
                <dt>Localización</dt>
                <dd>@(Model.Location ?? "No especificada")</dd>
            </div>
        </dl>
    </div>

    <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" class="panel-footer">
        <button type="submit" class="btn btn-primary">Sí, desactivar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>
