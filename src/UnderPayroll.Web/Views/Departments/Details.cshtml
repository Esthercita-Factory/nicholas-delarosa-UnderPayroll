@model UnderPayroll.Web.ViewModels.Departments.DepartmentDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="page-header">
    <div>
        <span class="eyebrow">Departamento</span>
        <h1>@Model.Name</h1>
    </div>
</div>

<div class="panel">
    <div class="panel-heading">
        <h2>Ficha del departamento</h2>
        <partial name="_StatusBadge" model="Model.IsActive"/>
    </div>

    <div class="panel-body">
        <dl class="detail-list">
            <div>
                <dt>Código</dt>
                <dd>@Model.Code</dd>
            </div>
            <div>
                <dt>Localización</dt>
                <dd>@(Model.Location ?? "No especificada")</dd>
            </div>
            <div>
                <dt>Presupuesto</dt>
                <dd>@Model.BudgetTexto</dd>
            </div>
            <div>
                <dt>Teléfono</dt>
                <dd>@(Model.Phone ?? "No especificado")</dd>
            </div>
            <div>
                <dt>Correo electrónico</dt>
                <dd>@(Model.Email ?? "No especificado")</dd>
            </div>
            <div class="detail-wide">
                <dt>Descripción</dt>
                <dd>@(Model.Description ?? "No especificada")</dd>
            </div>
            <div>
                <dt>Creado</dt>
                <dd>@Model.CreatedAtTexto</dd>
            </div>
            <div>
                <dt>Última actualización</dt>
                <dd>@Model.UpdatedAtTexto</dd>
            </div>
        </dl>
    </div>

    <div class="panel-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
    </div>
</div>
