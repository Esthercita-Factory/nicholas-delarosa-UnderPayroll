@model UnderPayroll.Web.ViewModels.Departments.DepartmentDetailsViewModel

<h1>Detalles del departamento</h1>

<div class="card">
    <div class="card-body">

        <h2 class="card-title">
            @Model.Name
        </h2>

        <p>
            <strong>Código:</strong>
            @Model.Code
        </p>

        <p>
            <strong>Descripción:</strong>
            @(Model.Description ?? "No especificada")
        </p>

        <p>
            <strong>Localización:</strong>
            @(Model.Location ?? "No especificada")
        </p>

        <p>
            <strong>Presupuesto:</strong>
            @Model.BudgetTexto
        </p>

        <p>
            <strong>Teléfono:</strong>
            @(Model.Phone ?? "No especificado")
        </p>

        <p>
            <strong>Correo:</strong>
            @(Model.Email ?? "No especificado")
        </p>

        <p>
            <strong>Estado:</strong>

            @if (Model.IsActive)
            {
                <span class="badge bg-success">Activo</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactivo</span>
            }
        </p>

        <p>
            <strong>Creado:</strong>
            @Model.CreatedAtTexto
        </p>

        <p>
            <strong>Última actualización:</strong>
            @Model.UpdatedAtTexto
        </p>

    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Editar
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>
</div>