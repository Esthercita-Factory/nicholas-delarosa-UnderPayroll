@model IEnumerable<UnderPayroll.Web.ViewModels.Departments.DepartmentListItemViewModel>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Departamentos</h1>

    <a asp-action="Create"
       class="btn btn-primary">
        Crear departamento
    </a>
</div>

<div class="row">

    @foreach (var department in Model)
    {
        <div class="col-md-6 col-lg-4 mb-4">

            <div class="card h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <h4 class="card-title">
                                @department.Name
                            </h4>

                            <small class="text-muted">
                                Código: @department.Code
                            </small>
                        </div>

                        @if (department.IsActive)
                        {
                            <span class="badge bg-success">
                                Activo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactivo
                            </span>
                        }

                    </div>

                    <hr />

                    <p>
                        <strong>Descripción:</strong><br />
                        @(department.Description ?? "No especificada")
                    </p>

                    <p>
                        <strong>Localización:</strong>
                        @(department.Location ?? "No especificada")
                    </p>

                    <p>
                        <strong>Presupuesto:</strong>

                        @if (department.Budget.HasValue)
                        {
                            @department.Budget.Value.ToString(
                                "C",
                                new System.Globalization.CultureInfo("es-CO"))
                        }
                        else
                        {
                            <span>No especificado</span>
                        }
                    </p>

                    @if (!string.IsNullOrWhiteSpace(department.Phone))
                    {
                        <p>
                            <strong>Teléfono:</strong>
                            @department.Phone
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(department.Email))
                    {
                        <p>
                            <strong>Email:</strong>
                            @department.Email
                        </p>
                    }

                </div>

                <div class="card-footer">

                    <a asp-action="Details"
                       asp-route-id="@department.Id"
                       class="btn btn-info">
                        Ver
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@department.Id"
                       class="btn btn-warning">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@department.Id"
                       class="btn btn-danger">
                        Eliminar
                    </a>

                </div>

            </div>

        </div>
    }

</div>