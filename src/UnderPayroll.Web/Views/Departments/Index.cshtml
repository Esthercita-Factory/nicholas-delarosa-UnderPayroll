@model IEnumerable<UnderPayroll.Web.ViewModels.Departments.DepartmentListItemViewModel>
@{
    ViewData["Title"] = "Departamentos";

    // Filtros vigentes, definidos por el controlador
    var filtros = new ListFilterViewModel(
        ViewData["Activo"] as bool?,
        ViewData["Busqueda"] as string,
        "Buscar por nombre, código o localización");
    var hayFiltros = filtros.Activo.HasValue || !string.IsNullOrWhiteSpace(filtros.Busqueda);
    var cultura = new System.Globalization.CultureInfo("es-CO");
}

<div class="page-header">
    <div>
        <span class="eyebrow">Organización</span>
        <h1>Departamentos</h1>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nuevo departamento</a>
</div>

<partial name="_ListFilters" model="filtros"/>

<div class="panel">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <h2>No hay departamentos para mostrar</h2>
            <p class="mb-0">@(hayFiltros ? "Prueba con otra búsqueda o cambia el filtro." : "Crea el primero para empezar a organizar a tu equipo.")</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table">
                <thead>
                <tr>
                    <th>Departamento</th>
                    <th>Localización</th>
                    <th class="num">Presupuesto</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var department in Model)
                {
                    <tr>
                        <td>
                            <span class="cell-title">@department.Name</span>
                            <span class="cell-meta">@department.Code</span>
                        </td>
                        <td>@(department.Location ?? "No especificada")</td>
                        <td class="num">
                            @(department.Budget.HasValue ? department.Budget.Value.ToString("C", cultura) : "No especificado")
                        </td>
                        <td><partial name="_StatusBadge" model="department.IsActive"/></td>
                        <td class="cell-actions">
                            <a asp-action="Details" asp-route-id="@department.Id"
                               class="btn btn-sm btn-outline-primary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@department.Id"
                               class="btn btn-sm btn-outline-secondary">Editar</a>

                            @* Acciones menos frecuentes agrupadas en un menú *@
                            <div class="dropdown d-inline-block">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false">Más</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (department.IsActive)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-action="Deactivate"
                                               asp-route-id="@department.Id">Desactivar</a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <form asp-action="Activate" asp-route-id="@department.Id" method="post">
                                                <button type="submit" class="dropdown-item">Reactivar</button>
                                            </form>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item text-danger" asp-action="Delete"
                                           asp-route-id="@department.Id">Eliminar</a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
