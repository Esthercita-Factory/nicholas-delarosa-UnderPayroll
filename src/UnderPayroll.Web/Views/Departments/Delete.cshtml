@model UnderPayroll.Web.ViewModels.Departments.DepartmentDetailsViewModel

<h1>Eliminar departamento</h1>

<div class="alert alert-danger">
    <h4>¿Seguro que quieres eliminar este departamento?</h4>
    <p>
        Esta acción eliminará permanentemente el departamento.
    </p>
</div>

<div class="card mb-3">
    <div class="card-body">

        <h2>@Model.Name</h2>

        <p>
            <strong>Código:</strong>
            @Model.Code
        </p>

        <p>
            <strong>Descripción:</strong>
            @(Model.Description ?? "No especificada")
        </p>

        <p>
            <strong>Ubicación:</strong>
            @(Model.Location ?? "No especificada")
        </p>

    </div>
</div>

<form asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit"
            class="btn btn-danger">
        Sí, eliminar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>